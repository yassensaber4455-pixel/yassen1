/* ==========================================================================
   LifeQuest Gaming Theme Stylesheet
   ========================================================================== */

/* Color Variables & Base Reset */
:root {
    --bg-main: #0b0f19;
    --bg-card: #151c2c;
    --bg-card-hover: #1e293b;
    --accent-primary: #6366f1;
    --accent-glow: #818cf8;
    --accent-green: #10b981;
    --accent-gold: #f59e0b;
    --accent-fire: #ef4444;
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
    --border-color: #334155;
    --radius-lg: 16px;
    --radius-md: 10px;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body.dark-theme {
    background-color: var(--bg-main);
    color: var(--text-main);
    min-height: 100vh;
}

/* Header & Navigation Bar */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 30px;
    background-color: rgba(21, 28, 44, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 100;
}

.logo-container {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--accent-primary);
}

.nav-links {
    display: flex;
    gap: 20px;
}

.nav-item {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
    padding: 8px 14px;
    border-radius: var(--radius-md);
    transition: all 0.3s ease;
}

.nav-item:hover, .nav-item.active {
    color: var(--text-main);
    background-color: var(--accent-primary);
}

.user-level-badge {
    background: #1e293b;
    padding: 8px 16px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    min-width: 160px;
}

.level-info {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    margin-bottom: 4px;
}

.level-title {
    color: var(--accent-gold);
    font-weight: bold;
}

.mini-progress-bar {
    width: 100%;
    height: 6px;
    background-color: #334155;
    border-radius: 3px;
    overflow: hidden;
}

.mini-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent-gold), #fbbf24);
    transition: width 0.4s ease;
}

.mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    color: var(--text-main);
    font-size: 1.5rem;
    cursor: pointer;
}

/* Layout & Page Container */
.main-container {
    max-width: 1200px;
    margin: 30px auto;
    padding: 0 20px;
}

.page-view {
    display: none;
    animation: fadeIn 0.4s ease-in-out;
}

.page-view.active {
    display: block;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}

/* Hero & Landing Page */
.hero-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    padding: 60px 0;
}

.hero-title {
    font-size: 3rem;
    margin-bottom: 15px;
    line-height: 1.2;
}

.hero-title .highlight {
    color: var(--accent-primary);
}

.hero-subtitle {
    color: var(--text-muted);
    font-size: 1.2rem;
    margin-bottom: 30px;
}

.avatar-card-preview {
    background: var(--bg-card);
    padding: 40px;
    border-radius: var(--radius-lg);
    text-align: center;
    border: 1px solid var(--border-color);
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
}

.avatar-card-preview img {
    width: 150px;
    height: 150px;
    margin-bottom: 20px;
}

/* Dashboards & Cards */
.welcome-banner {
    margin-bottom: 25px;
}

.daily-challenge-card {
    background: linear-gradient(135deg, #1e1b4b, #312e81);
    border: 1px solid var(--accent-primary);
    border-radius: var(--radius-lg);
    padding: 20px;
    margin-bottom: 30px;
}

.challenge-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
}

.xp-reward {
    background: var(--accent-gold);
    color: #000;
    font-weight: bold;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.85rem;
}

.stats-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
}

.stat-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 15px;
}

.stat-icon {
    font-size: 2rem;
    padding: 15px;
    border-radius: var(--radius-md);
    background: #1e293b;
}

.stat-icon.fire { color: var(--accent-fire); }
.stat-icon.star { color: var(--accent-gold); }
.stat-icon.target { color: var(--accent-primary); }
.stat-icon.trophy { color: #ec4899; }

.stat-number {
    font-size: 1.4rem;
    font-weight: bold;
}

/* Tables & Mission Views */
.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.table-responsive {
    overflow-x: auto;
}

.missions-table {
    width: 100%;
    border-collapse: collapse;
    background-color: var(--bg-card);
    border-radius: var(--radius-lg);
    overflow: hidden;
}

.missions-table th, .missions-table td {
    padding: 16px;
    text-align: right;
    border-bottom: 1px solid var(--border-color);
}

.missions-table th {
    background-color: #1e293b;
    color: var(--text-muted);
}

.badge {
    background-color: #334155;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.85rem;
}

.xp-badge {
    color: var(--accent-gold);
    font-weight: bold;
}

/* Achievements Grid */
.achievements-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 20px;
}

.achievement-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 25px;
    text-align: center;
    transition: transform 0.3s ease;
}

.achievement-card.locked {
    opacity: 0.5;
    filter: grayscale(1);
}

.achievement-icon {
    font-size: 3rem;
    margin-bottom: 10px;
}

/* Charts & Profile */
.charts-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.chart-card {
    background-color: var(--bg-card);
    border-radius: var(--radius-lg);
    padding: 20px;
    border: 1px solid var(--border-color);
}

.profile-card, .settings-card {
    background-color: var(--bg-card);
    border-radius: var(--radius-lg);
    padding: 40px;
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
    border: 1px solid var(--border-color);
}

.profile-avatar-wrapper img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 4px solid var(--accent-primary);
    margin-bottom: 15px;
}

.profile-mini-stats {
    display: flex;
    justify-content: space-around;
    margin-top: 30px;
}

/* Modals & Forms */
.modal-overlay {
    display: none;
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.8);
    justify-content: center;
    align-items: center;
    z-index: 1000;
}

.modal-overlay.active { display: flex; }

.modal-card {
    background: var(--bg-card);
    border-radius: var(--radius-lg);
    padding: 30px;
    width: 90%;
    max-width: 500px;
    border: 1px solid var(--border-color);
}

.form-group {
    margin-bottom: 15px;
    text-align: right;
}

.form-control {
    width: 100%;
    padding: 10px;
    background: #1e293b;
    border: 1px solid var(--border-color);
    color: var(--text-main);
    border-radius: var(--radius-md);
    margin-top: 5px;
}

/* Buttons */
.btn {
    padding: 10px 20px;
    border-radius: var(--radius-md);
    border: none;
    font-weight: bold;
    cursor: pointer;
    transition: 0.2s ease;
}

.btn-primary { background: var(--accent-primary); color: white; }
.btn-primary:hover { background: var(--accent-glow); }
.btn-success { background: var(--accent-green); color: white; }
.btn-danger { background: var(--accent-fire); color: white; }
.btn-outline { background: transparent; border: 1px solid var(--border-color); color: var(--text-main); }
.btn-sm { padding: 6px 12px; font-size: 0.85rem; }

/* Mobile Responsiveness */
@media (max-width: 768px) {
    .nav-links {
        display: none;
        flex-direction: column;
        position: absolute;
        top: 70px; right: 0; width: 100%;
        background: var(--bg-card);
        padding: 20px;
    }

    .nav-links.active { display: flex; }
    .mobile-menu-btn { display: block; }
    .hero-section, .charts-grid { grid-template-columns: 1fr; }
}
